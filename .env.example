APP_NAME="Al Rahma Hospital HMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Africa/Mogadishu is UTC+3 with no daylight saving.
# APP_TIMEZONE stays UTC: timestamps are stored in UTC and converted for
# display and reporting. Do not change this to a local zone.
APP_TIMEZONE=UTC
APP_LOCALE=en

# --- Hospital identity -------------------------------------------------------
# Structural defaults only. Anything staff should be able to change lives in
# the `settings` table, editable in Administration -> Hospital Settings.
HOSPITAL_NAME="Al Rahma Hospital"
HOSPITAL_ADDRESS="Qardho Main Road, Qardho, Somalia"
HOSPITAL_TIMEZONE=Africa/Mogadishu
HOSPITAL_UTC_OFFSET_HOURS=3
HOSPITAL_CURRENCY=USD
HOSPITAL_CURRENCY_SYMBOL=$
HOSPITAL_BILLING_MODE=pay_before_service

# --- Database ----------------------------------------------------------------
# InnoDB only. MyISAM is not crash-safe, and the power here is not reliable.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=al_rahma_hms
DB_USERNAME=hms_app
DB_PASSWORD=

# --- Session and cache -------------------------------------------------------
# Database drivers throughout: no Redis daemon to install, monitor and restart
# after a power cut, for no benefit at this number of users.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false   # set true once HTTPS is in place
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Backups -----------------------------------------------------------------
BACKUP_ARCHIVE_PASSWORD=
BACKUP_EXTERNAL_PATH=/mnt/backup-usb

# No mail service is assumed: most staff have no email address, and the server
# usually has no internet. Password resets are done by an administrator.
MAIL_MAILER=log
